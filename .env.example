# backend
DATABASE_URL=postgresql://trinetra:trinetra@db:5432/trinetra
LLM_API_KEY=                      # fallback key for any provider without its own key below
GEMINI_API_KEY=                   # used for models named gemini/...
GROQ_API_KEY=                     # optional: only for models named groq/... (no automatic fallback)
LLM_API_BASE=                     # optional, for OpenAI-compatible endpoints
LLM_EXTRACT_MODEL=gemini/gemini-3.1-flash-lite  # behaviours, Sigma rules, eval baseline
LLM_VERIFY_MODEL=gemini/gemini-3.1-flash-lite   # verifier, IOC roles, guard, briefing
LLM_CONCURRENCY=8
LLM_CACHE=true                    # set false only to measure real latency
LLM_TOKENS_PER_MINUTE=0           # TPM limit for providers without their own setting; 0 = off
LLM_TPM_GEMINI=225000             # Gemini tokens-per-minute limit for your tier
LLM_TPM_GROQ=                     # Groq tokens-per-minute limit for your tier (8000 on on_demand); empty = no pacing
LLM_RPM_GEMINI=14                 # Gemini requests-per-minute limit for your tier
LLM_RPM_GROQ=30                   # only used if a slot is set to a groq/ model
MAPPING_CONFIDENCE_THRESHOLD=0.6
FIRECRAWL_API_KEY=
NVD_API_KEY=                      # optional; raises NVD rate limits
N8N_WEBHOOK_URL=
ATTACK_VERSION=20.0
EMBED_MODEL=BAAI/bge-small-en-v1.5
CORS_ORIGINS=http://localhost:3000
GEOIP_DB_PATH=/data/dbip-city-lite.mmdb
# frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCKS=true
